# --- Environment Setup ---
# Define the path to the Excel file and the folder for results
file_path <- "C:/Users/Alfonso/Desktop/AlfonsoOA_MSI/2Docencia/8_TrabajoCuestionesMetabolicas/0_AnalisisSelectividad/Resumen_Selectividad.xlsx"
results_path <- "C:/Users/Alfonso/Desktop/AlfonsoOA_MSI/2Docencia/8_TrabajoCuestionesMetabolicas/0_AnalisisSelectividad/PAU_analysis_results"

# Create results folder if it does not exist
if (!dir.exists(results_path)) {
  dir.create(results_path)
}

# --- Load and Prepare Data ---
# Read data from the Excel file
data <- read_excel(file_path)

# Clean data and create binary variable 'is_question'
data <- data %>%
  mutate(
    N_questions = replace(N_questions, is.na(N_questions), ""),
    is_question = ifelse(N_questions == "x", 1, 0)
  )

# --- Utility Functions ---
# Function to create a summary table per exam
# (key for aggregating 'x's by exam)
get_exam_summary <- function(data) {
  exam_summary <- data %>%
    group_by(Year, Call, Option) %>%
    summarise(has_metabolism_q = ifelse(sum(is_question) > 0, 1, 0), .groups = 'drop')
  return(exam_summary)
}

# ----------------------------------------------------
# 1. Is metabolism asked less frequently than other blocks? (FINAL CORRECTED)
# ----------------------------------------------------
sink(file.path(results_path, "1_Global_Frequency.txt"))
cat("### 1. Global Frequency of Metabolism Block ###\n\n")

# Use summary table to count exams, not individual questions
exam_summary <- get_exam_summary(data)

exams_with_metabolism_observed <- sum(exam_summary$has_metabolism_q)
total_exams_possible <- nrow(exam_summary)

# Null hypothesis (H0): all exams should have at least one metabolism question
expected_exams_with_metabolism <- total_exams_possible

# Statistical test: Binomial test
binomial_test_1 <- binom.test(x = exams_with_metabolism_observed, 
                              n = total_exams_possible, 
                              p = 1,
                              alternative = "less") # Alternative: fewer metabolism questions than expected

cat("--------------------------------------------\n")
cat("Analysis of exam distribution by block\n")
cat("--------------------------------------------\n")
cat("Total exams (population):", total_exams_possible, "\n")
cat("Exams with metabolism questions (observed):", exams_with_metabolism_observed, "\n")
cat("Exams with metabolism questions (expected):", expected_exams_with_metabolism, "\n\n")
cat("Binomial Test Result:\n")
print(binomial_test_1)

if (binomial_test_1$p.value < 0.05) {
  cat("\nConclusion: p-value (", binomial_test_1$p.value, ") < 0.05. Null hypothesis rejected.\n")
  cat("Frequency of exams with metabolism questions is significantly lower than expected.\n")
  cat("Specifically, metabolism is NOT asked in all exams as would be expected if topic distribution were uniform.\n")
} else {
  cat("\nConclusion: p-value > 0.05. No statistical evidence to reject the null hypothesis.\n")
  cat("Metabolism questions appear in most exams, as expected.\n")
}
sink()

# ----------------------------------------------------
# 2. Over time, is metabolism asked less frequently?
# ----------------------------------------------------
sink(file.path(results_path, "2_Temporal_Evolution_Questions.txt"))
cat("### 2. Temporal Evolution of Number of Metabolism Questions ###\n\n")

exam_summary <- get_exam_summary(data)

questions_per_year <- exam_summary %>%
  group_by(Year) %>%
  summarise(Total_Exams_with_Metabolism = sum(has_metabolism_q), .groups = 'drop') %>%
  mutate(Year = as.numeric(as.character(Year)))

all_years <- data.frame(Year = 2001:2024)
questions_per_year <- all_years %>%
  left_join(questions_per_year, by = "Year") %>%
  mutate(Total_Exams_with_Metabolism = replace_na(Total_Exams_with_Metabolism, 0))

lm_model_2 <- lm(Total_Exams_with_Metabolism ~ Year, data = questions_per_year)

cat("--------------------------------------------\n")
cat("Annual Trend Analysis\n")
cat("--------------------------------------------\n")
cat("Annual values (exams with metabolism questions):\n")
print(questions_per_year)
cat("\nStatistical Test: Linear Regression Model\n")
summary_lm_2 <- summary(lm_model_2)
print(summary_lm_2)

if (summary_lm_2$coefficients["Year", "Pr(>|t|)"] < 0.05) {
  if (summary_lm_2$coefficients["Year", "Estimate"] < 0) {
    cat("\nConclusion: Significant negative trend. Metabolism is asked LESS over time.\n")
  } else {
    cat("\nConclusion: Significant positive trend. Metabolism is asked MORE over time.\n")
  }
} else {
  cat("\nConclusion: No significant linear trend in metabolism questions over time.\n")
}
sink()

plot_2 <- ggplot(questions_per_year, aes(x = Year, y = Total_Exams_with_Metabolism)) +
  geom_line(color = "blue") +
  geom_point(color = "blue") +
  geom_smooth(method = "lm", se = FALSE, color = "red") +
  labs(title = "Annual Evolution of Exams with Metabolism",
       x = "Year",
       y = "Total Exams with Metabolism (Max. 4)") +
  theme_minimal() +
  scale_x_continuous(breaks = seq(2001, 2024, by = 2))
ggsave(file.path(results_path, "2_Temporal_Evolution_Questions.png"), plot_2)

# ----------------------------------------------------
# 3. Significant preferences for certain subgroups (items)?
# ----------------------------------------------------
sink(file.path(results_path, "3_Subgroup_Preferences.txt"))
cat("### 3. Significant Preferences by Subgroups (items) ###\n\n")

item_frequency <- data %>%
  filter(is_question == 1) %>%
  group_by(Item) %>%
  summarise(Count = n(), .groups = 'drop') %>%
  arrange(desc(Count))

chi_sq_test_3 <- chisq.test(item_frequency$Count)

cat("--------------------------------------------\n")
cat("Most frequent items distribution\n")
cat("--------------------------------------------\n")
cat("Top 5 items:\n")
print(head(item_frequency, 5))
cat("\nChi-square Test Result:\n")
print(chi_sq_test_3)

if (chi_sq_test_3$p.value < 0.05) {
  cat("\nConclusion: Null hypothesis rejected. Significant preference for certain items.\n")
} else {
  cat("\nConclusion: No evidence of preference. Item distribution is uniform.\n")
}
sink()

plot_3 <- ggplot(item_frequency, aes(x = reorder(Item, Count), y = Count)) +
  geom_bar(stat = "identity", fill = "skyblue") +
  labs(title = "Frequency of Metabolism Questions by Subtopic",
       x = "Subtopic",
       y = "Number of Times Asked") +
  theme_minimal() +
  coord_flip()
ggsave(file.path(results_path, "3_Subgroup_Preferences.png"), plot_3, width = 10, height = 8)

